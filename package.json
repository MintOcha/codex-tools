  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codex",
    "search",
    "web-search",
    "browser",
    "chatgpt",
    "claude",
    "cursor"
  ],
  "author": "MintOcha",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MintOcha/codex-tools.git"
  },
  "bugs": {
    "url": "https://github.com/MintOcha/codex-tools/issues"
  },
  "homepage": "https://github.com/MintOcha/codex-tools#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}
