{
  "name": "@mintocha/codex-tools",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for live web search, page extraction, and alpha tools via reversed Codex backend",
  "bin": {
    "codex-tools": "dist/src/index.js"
  },
  "main": "./dist/src/index.js",
  "type": "module",
